PORT=3000
APP_NAME=IndiaNikah AI Content Hub
APP_VERSION=0.1.0
NODE_ENV=development
DATABASE_URL="file:./prisma/dev.db"

# Production IndiaNikah MySQL - SELECT-only account.
# Local development through SSH tunnel: host 127.0.0.1, port 3307.
# VPS deployment: host 127.0.0.1, port 3306.
PROD_DB_HOST=127.0.0.1
PROD_DB_PORT=3307
PROD_DB_NAME=django
PROD_DB_USER=contenthub_reader
PROD_DB_PASSWORD=

# Disabled by default locally. Enable on the VPS after deployment.
PROFILE_IMPORT_CRON_ENABLED=false
PROFILE_IMPORT_CRON="0 8 * * *"
PROD_DB_POOL_SIZE=3

# Telegram publishing
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=@IndiaNikah
TELEGRAM_PUBLISH_ENABLED=false
AI_GENERATION_ENABLED=false
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini

PUBLISH_PLATFORMS=TELEGRAM
BOOK_REPUBLISH_AFTER_DAYS=90
GUIDELINE_REPUBLISH_AFTER_DAYS=60
BLOG_REPUBLISH_AFTER_DAYS=180
CONTENT_QUEUE_CRON_ENABLED=false
CONTENT_QUEUE_CRON="15 * * * *"
QUEUE_TARGET_READY=6
QUEUE_AUTO_PUBLISH=false

FACEBOOK_PUBLISH_ENABLED=false
FACEBOOK_GRAPH_VERSION=v25.0
FACEBOOK_PAGE_ID=
FACEBOOK_PAGE_ACCESS_TOKEN=

# X publishing (OAuth 1.0a user context)
X_PUBLISH_ENABLED=false
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_TOKEN_SECRET=
X_USERNAME=

# Instagram publishing. Generated text-card images must be reachable by Meta
# through this public HTTPS directory.
INSTAGRAM_PUBLISH_ENABLED=false
INSTAGRAM_GRAPH_VERSION=v25.0
INSTAGRAM_USER_ID=
INSTAGRAM_SYSTEM_USER_TOKEN=
INSTAGRAM_MEDIA_PUBLIC_BASE_URL=https://your-domain.example/generated-media
INSTAGRAM_MEDIA_OUTPUT_DIR=public/generated-media
INDIANIKAH_WHATSAPP_NUMBER=918482833177
INDIANIKAH_WEBSITE_URL=https://www.indianikah.com

# Cloudflare R2 storage for generated Instagram cards
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=indianikah
R2_INSTAGRAM_PREFIX=instagram/posts
R2_SIGNED_URL_SECONDS=3600

# Milestone 2 profile importer tuning
PROFILE_IMPORT_BATCH_SIZE=250
PROFILE_IMPORT_MAX_BATCHES=20
PROD_DB_QUEUE_LIMIT=20
PROD_DB_CONNECT_TIMEOUT_MS=10000

# Milestone 3 generation
# AUTO uses OpenAI only when enabled and configured; otherwise safe local templates.
MILESTONE3_DEFAULT_PROVIDER=AUTO

# Controlled daily automation (all schedule values use Asia/Kolkata).
# A profile summary has one stable India-date key, so reruns on the same day
# reuse it. Together, the two schedules publish at most two posts per India day.
CONTENT_AUTOMATION_MODE=MANUAL_APPROVAL
AUTO_APPROVE_ENABLED=false
AUTO_PUBLISH_ENABLED=false
PROFILE_SUMMARY_SCHEDULER_ENABLED=false
PROFILE_SUMMARY_HOUR_IST=10
PROFILE_SUMMARY_MINUTE_IST=0
WEEKLY_CONTENT_SCHEDULER_ENABLED=false
WEEKLY_CONTENT_HOUR_IST=20
WEEKLY_CONTENT_MINUTE_IST=30
CONTENT_QUEUE_SCHEDULER_ENABLED=false
CONTENT_QUEUE_INTERVAL_MINUTES=5
MAX_AUTO_POSTS_PER_DAY=2
ENABLED_PUBLISH_PLATFORMS=TELEGRAM
SEND_PUBLISH_EMAIL_REPORT=false
